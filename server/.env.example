# Copy to server/.env for local development. Values below match `supabase start`.

PORT=8080
# Where the web app runs (links in emails, Stripe redirects).
APP_URL=http://localhost:3000

# Local Supabase Postgres (the database owner role; RLS does not apply to it).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API. Tokens are verified against its JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Public key for Supabase Auth requests (from `supabase status`, "Publishable key").
SUPABASE_PUBLISHABLE_KEY=
# Server-side key for Storage uploads (from `supabase status`, "Secret key").
SUPABASE_SECRET_KEY=

# Google AI Studio key (required): embeddings and chat answers.
GEMINI_API_KEY=

# Folder with the exported client (set in the Docker image; empty in dev).
STATIC_DIR=

# Stripe test mode (required). Webhook secret: stripe listen --forward-to localhost:8080/api/billing/webhook
# Price ids: the hovr Pro and hovr Business monthly prices in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
